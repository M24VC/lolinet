{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lolinet",
  "main": "functions/_worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
      "/llms.txt"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lolinet-db",
      "database_id": "82bc6f39-ab35-4780-81c9-b5f8b1fb0199"
    }
  ]
}