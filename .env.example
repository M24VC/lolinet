# ==============================================================
# LoliNet Configuration Template
# Copy this file to .env before starting the server:
# cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================

# Server Listening Port (Default: 3000)
PORT=3000

# SQLite Database File Location
DB_PATH=./data/lolinet.db

# Session Secret Key (Please change this to a random 32+ character string in production)
SESSION_SECRET=change-me-to-a-very-secure-random-string-32chars

# Initial Administrator Credentials (Generated on first launch or via npm run reset-admin)
ADMIN_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123
